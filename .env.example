# --- Database (Postgres) ---
# Local dev (direct): point at a running Postgres.
DATABASE_URL=postgresql://santa:santa@localhost:5432/santa

# Used by docker-compose to provision the bundled Postgres service.
POSTGRES_USER="santa"
POSTGRES_PASSWORD="santa"
POSTGRES_DB="santa"

# --- Better Auth ---
# Generate a strong secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Public base URL used in WhatsApp reveal links and the client
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email of the user that should be auto-promoted to admin on signup.
# The very first registered user is also promoted automatically.
ADMIN_EMAIL=you@example.com

# --- WhatsApp Cloud API (Meta Graph API) ---
# Only needed for the `wa_link` / `wa_direct` delivery modes.
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE_NAME=amigo_secreto
WA_TEMPLATE_LANGUAGE=pt_PT

# --- Email (Resend) — optional ---
# When both are set, draw results are also emailed to participants whose
# account email is known. Leave unset to disable email entirely.
RESEND_API_KEY=
RESEND_FROM=Secret Santa <santa@your.domain>

# --- Web Push (PWA notifications) — optional ---
# Generate a key pair once: `npx web-push generate-vapid-keys`
# The public key must be set in BOTH places (server + client-inlined).
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
